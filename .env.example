# Flask / Gunicorn
PORT=5010
WEB_CONCURRENCY=2
# 반드시 충분히 긴 무작위 값으로 변경하세요.
EPUBIA_SECRET_KEY=replace-with-a-long-random-secret
# 로컬 HTTP는 0, HTTPS 프록시 운영은 1
SESSION_COOKIE_SECURE=0
# 운영 공개 주소. HTML 책은 관리자 세션과 분리된 전용 서브도메인을 사용합니다.
EPUBIA_PUBLIC_ORIGIN=https://epub.xsw.kr
EPUBIA_HTML_CONTENT_ORIGIN=https://html.epub.xsw.kr
# 운명서재 구매·샘플 연결 주소
SAJU_LIBRARY_ORIGIN=https://saju.xsw.kr
# 두 앱이 공유하는 열람권 HMAC 키. 비워 두면 아래 0600 파일을 양쪽 앱이 함께 사용합니다.
EBOOK_ACCESS_SECRET=
EBOOK_ACCESS_SECRET_FILE=/home/reset980/.config/epubia-commerce/access-secret
# HTML 읽기 주소의 서명 유효시간(5분~24시간, 기본 12시간)
EPUBIA_HTML_CONTENT_TOKEN_TTL_SECONDS=43200

# 접근을 허용할 기존 YouTube Shorts 계정
EPUBIA_ALLOWED_USERS=admin,user@example.com
# 프론트 상단·홈·하단을 편집할 계정만 쉼표로 지정합니다.
# 생략하면 admin, khg334, khg334@hanmail.net만 편집할 수 있습니다.
EPUBIA_SITE_EDITORS=admin,khg334,khg334@hanmail.net
YOUTUBE_SHORTS_ADMIN_USER=admin
YOUTUBE_SHORTS_ADMIN_PASSWORD=
YOUTUBE_SHORTS_ROOT=/home/reset980/youtube_shorts

# AI 표지 생성. 키는 화면이나 site-settings.json에 저장하지 않습니다.
OPENAI_API_KEY=

# 비밀번호 찾기 메일 (선택)
JARVIS_BOT_ROOT=/home/reset980/Jarvis_bot
EPUBIA_EMAIL_MAP=admin:admin@example.com
EPUBIA_FORGOT_COOLDOWN=180
NAVER_SMTP_HOST=smtp.naver.com
NAVER_SMTP_PORT=587
NAVER_MAIL_USER=
NAVER_MAIL_PASS=
